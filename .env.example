# SIDIA Automation Configuration
# Copy this file to .env and update with your credentials

# SIDIA System Credentials
SIDIA_USERNAME=your_username_here
SIDIA_PASSWORD=your_password_here

# SIDIA System URL
SIDIA_BASE_URL=https://sidia.bpjsketenagakerjaan.go.id

# Automation Settings
TIMEOUT=30000
RETRY_ATTEMPTS=10
RETRY_DELAY=3000
HEADLESS=false

# Feedback Message
FEEDBACK_MESSAGE=dipedomani dan dilaksanakan

# Document Types to Process (comma-separated codes)
# Available codes: NKH0002, NKH0001, NKH0016, NKH0017
DOCUMENT_TYPES=NKH0002,NKH0001,NKH0016,NKH0017
