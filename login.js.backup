/**
 * Login Module
 * Handles authentication and role selection
 */

const chalk = require('chalk');
const { sleep } = require('./utils');
const { SELECTORS, TEXT_PATTERNS, TIMING, RETRY_LIMITS } = require('./constants');
const { pageContainsText, getPageState } = require('./pageHelper');
const { traditionalType, clickButtonByTextTraditional } = require('./clickHelper');
const { clickAndVerify } = require('./verification');
const { clickAndVerifyWithFallback, captureScreenshot, capturePageStructure } = require('./visualHelper');

/**
 * Login to SIDIA system
 * @param {Page} page - Puppeteer page instance
 * @param {Object} config - Configuration object
 * @returns {Promise<boolean>} True if login successful
 */
async function login(page, config) {
    console.log(chalk.yellow('\n🔐 STEP 1: Logging in...'));

    console.log(chalk.gray('  → Navigating to login page...'));
    await page.goto(config.baseUrl, { waitUntil: 'networkidle2' });
    await sleep(TIMING.PAGE_LOAD);

    // Check if already logged in
    const pageInfo = await getPageState(page);
    console.log(chalk.gray(`  → Page URL: ${pageInfo.url}`));
    console.log(chalk.gray(`  → Has login form: ${pageInfo.hasPasswordField}`));

    if (!pageInfo.hasPasswordField) {
        console.log(chalk.yellow('  ⚠ No login form found - might already be logged in'));
        return true;
    }

    // Enter credentials
    await enterCredentials(page, config);

    // Attempt login with retry logic
    const loginSuccess = await attemptLogin(page);

    if (!loginSuccess) {
        throw new Error(`Login failed after ${RETRY_LIMITS.LOGIN_ATTEMPTS} attempts`);
    }

    // Verify login success
    const finalUrl = page.url();
    console.log(chalk.gray(`  → Final URL: ${finalUrl}`));

    if (finalUrl.includes('/login')) {
        throw new Error('Login failed - still on login page');
    }

    console.log(chalk.green('  ✓ Login successful'));
    return true;
}

/**
 * Enter username and password using traditional click and type approach
 * @param {Page} page - Puppeteer page instance
 * @param {Object} config - Configuration object
 */
async function enterCredentials(page, config) {
    // Enter username
    console.log(chalk.gray('  → Entering username...'));
    let usernameEntered = false;

    for (const selector of SELECTORS.login.username) {
        try {
            const result = await traditionalType(page, selector, config.username);
            if (result) {
                console.log(chalk.gray(`  ✓ Username entered using: ${selector}`));
                usernameEntered = true;
                break;
            }
        } catch (e) {
            continue;
        }
    }

    if (!usernameEntered) {
        throw new Error('Could not find username input field');
    }

    await sleep(TIMING.FIELD_INPUT);

    // Enter password
    console.log(chalk.gray('  → Entering password...'));
    let passwordEntered = false;

    for (const selector of SELECTORS.login.password) {
        try {
            const result = await traditionalType(page, selector, config.password);
            if (result) {
                console.log(chalk.gray(`  ✓ Password entered using: ${selector}`));
                passwordEntered = true;
                break;
            }
        } catch (e) {
            continue;
        }
    }

    if (!passwordEntered) {
        throw new Error('Could not find password input field');
    }

    await sleep(TIMING.FIELD_INPUT);
}

/**
 * Attempt login with retry logic using comprehensive click verification with visual fallback
 * @param {Page} page - Puppeteer page instance
 * @returns {Promise<boolean>} True if login successful
 */
async function attemptLogin(page) {
    console.log(chalk.gray('  → Clicking login button...'));

    let loginSuccess = false;
    let loginAttempts = 0;

    while (!loginSuccess && loginAttempts < RETRY_LIMITS.LOGIN_ATTEMPTS) {
        loginAttempts++;
        console.log(chalk.gray(`  → Login attempt ${loginAttempts}/${RETRY_LIMITS.LOGIN_ATTEMPTS}...`));

        // First, check for reCAPTCHA or other blocking elements
        const pageCheck = await page.evaluate(() => {
            const hasRecaptcha = document.querySelector('.grecaptcha-badge') !== null ||
                               document.querySelector('[src*="recaptcha"]') !== null;
            const hasOverlay = document.querySelector('.v-overlay') !== null;
            const hasSnackbar = document.querySelector('.v-snack__wrapper[style*="display: none"]') === null &&
                               document.querySelector('.v-snack__wrapper') !== null;

            return {
                hasRecaptcha: hasRecaptcha,
                hasOverlay: hasOverlay,
                hasVisibleSnackbar: hasSnackbar
            };
        });

        console.log(chalk.gray(`  → Page check: recaptcha=${pageCheck.hasRecaptcha}, overlay=${pageCheck.hasOverlay}, snackbar=${pageCheck.hasVisibleSnackbar}`));

        if (pageCheck.hasVisibleSnackbar) {
            console.log(chalk.yellow('  ⚠ Found visible snackbar/notification - may need to dismiss'));
            // Try to dismiss any notifications
            await page.evaluate(() => {
                const snackbar = document.querySelector('.v-snack__wrapper');
                if (snackbar) {
                    snackbar.style.display = 'none';
                }
            });
            await sleep(1000);
        }

        // Use comprehensive verification with visual fallback for login button click
        const result = await clickAndVerifyWithFallback(page, {
            elementDescription: 'Login button',
            findFn: () => {
                const buttons = Array.from(document.querySelectorAll('button, .v-btn, [type="submit"]'));
                const loginBtn = buttons.find(btn =>
                    SELECTORS.login.loginButtonText.some(text =>
                        (btn.textContent || '').includes(text)
                    )
                );
                return {
                    found: loginBtn !== null,
                    text: loginBtn ? (loginBtn.textContent || '').trim() : null,
                    disabled: loginBtn ? (loginBtn.disabled || loginBtn.classList.contains('v-btn--disabled')) : null
                };
            },
            clickFn: () => {
                const buttons = Array.from(document.querySelectorAll('button, .v-btn, [type="submit"]'));
                const loginBtn = buttons.find(btn =>
                    SELECTORS.login.loginButtonText.some(text =>
                        (btn.textContent || '').includes(text)
                    )
                );
                if (loginBtn && !loginBtn.disabled && !loginBtn.classList.contains('v-btn--disabled')) {
                    loginBtn.click();
                    return { clicked: true };
                }
                return { clicked: false };
            },
            verifyStateChangeFn: () => {
                const currentUrl = window.location.href;
                const hasPasswordField = document.querySelector('input[type="password"]') !== null;
                return {
                    verified: !currentUrl.includes('/login') || !hasPasswordField,
                    url: currentUrl,
                    hasPasswordField: hasPasswordField
                };
            },
            timeout: 15000,
            retryCount: 3
        });

        if (result.success) {
            if (result.method === 'fallback') {
                console.log(chalk.green(`  ✓ Login button clicked via FALLBACK: ${result.recommendation}`));
            } else {
                console.log(chalk.green(`  ✓ Login button clicked (attempt ${loginAttempts})`));
            }

            // CRITICAL: Wait longer for navigation and reCAPTCHA
            console.log(chalk.gray('  → Waiting for navigation and reCAPTCHA...'));
            await sleep(5000); // Increased from 3000 to 5000

            // Check if we're still on login page
            const currentUrl = page.url();
            console.log(chalk.gray(`  → Current URL after wait: ${currentUrl}`));

            if (currentUrl.includes('/login')) {
                console.log(chalk.yellow('  ⚠ Still on login page after click, waiting longer...'));
                await sleep(5000); // Wait another 5 seconds

                const recheckUrl = page.url();
                console.log(chalk.gray(`  → Recheck URL: ${recheckUrl}`));

                if (!recheckUrl.includes('/login')) {
                    console.log(chalk.green(`  ✓ Login successful (attempt ${loginAttempts})`));
                    loginSuccess = true;
                } else {
                    console.log(chalk.yellow('  → Still on login page, retrying...'));
                }
            } else {
                console.log(chalk.green(`  ✓ Login successful (attempt ${loginAttempts})`));
                console.log(chalk.gray(`  → Final URL: ${currentUrl}`));
                loginSuccess = true;
            }
        } else {
            console.log(chalk.yellow(`  → Login click verification failed: ${result.reason}`));

            // Show analysis if available
            if (result.analysis) {
                console.log(chalk.gray('  → Page analysis available in screenshots directory'));
            }

            // Check if we need to logout
            const pageState = await checkLoginPageState(page);
            if (pageState.needsLogout) {
                await handleLogout(page);
            } else if (loginAttempts < RETRY_LIMITS.LOGIN_ATTEMPTS) {
                console.log(chalk.gray('  → Retrying...'));
                await sleep(2000);
            }
        }
    }

    return loginSuccess;
}

/**
 * Check login page state
 * @param {Page} page - Puppeteer page instance
 * @returns {Promise<Object>} Page state information
 */
async function checkLoginPageState(page) {
    try {
        const currentUrl = page.url();
        const pageInfo = await getPageState(page);
        const needsLogout = await pageContainsText(page, TEXT_PATTERNS.logoutMessages);

        return {
            isOnLoginPage: currentUrl.includes('/login') || pageInfo.hasPasswordField,
            needsLogout: needsLogout && pageInfo.hasPasswordField,
            url: currentUrl
        };
    } catch (e) {
        console.log(chalk.yellow(`  ⚠ Could not check page state: ${e.message}`));
        return { isOnLoginPage: true, needsLogout: false, url: '' };
    }
}

/**
 * Handle logout for account active on another device using traditional click
 * @param {Page} page - Puppeteer page instance
 */
async function handleLogout(page) {
    console.log(chalk.yellow('  ⚠ Account active on another device. Clicking LOGOUT...'));

    const clicked = await clickButtonByTextTraditional(page, TEXT_PATTERNS.logoutButtons);

    if (clicked) {
        console.log(chalk.gray('  → Logout clicked, waiting...'));
        await sleep(TIMING.LOGOUT_WAIT);

        const stillHasMessage = await pageContainsText(page, TEXT_PATTERNS.logoutMessages);
        if (stillHasMessage) {
            console.log(chalk.yellow('  ⚠ Still showing logout message'));
        } else {
            console.log(chalk.green('  ✓ Logout successful'));
        }
    }
}

/**
 * Select role after login - Fixed for /role URL and PILIH ROLE title
 * @param {Page} page - Puppeteer page instance
 * @returns {Promise<void>}
 */
async function selectRole(page) {
    console.log(chalk.yellow('\n👤 STEP 2: Selecting Role...'));

    // Wait a bit for navigation after login
    await sleep(3000);

    // Check current URL
    const currentUrl = page.url();
    console.log(chalk.gray(`  → Current URL: ${currentUrl}`));

    // CAPTURE: Take screenshot AND HTML structure of role page
    await captureScreenshot(page, 'role_page_initial');
    await capturePageStructure(page, 'role_page_initial');

    // Check if we're on the role selection page
    const onRolePage = currentUrl.includes('/role') || currentUrl.includes('/select-role');

    // Also check for PILIH ROLE title in the page
    const hasRoleTitle = await page.evaluate(() => {
        const title = document.querySelector('.v-toolbar__title');
        return title && title.textContent.includes('PILIH ROLE');
    });

    // CRITICAL: Check if we're already logged in with a role selected
    const alreadyLoggedIn = await page.evaluate(() => {
        // Check if we're on dashboard or main page (not role, not login)
        const currentUrl = window.location.href;
        const hasMainMenu = document.querySelector('.v-list-item, [role="navigation"]') !== null;
        const hasNaskahMasuk = Array.from(document.querySelectorAll('*')).some(el =>
            el.textContent && el.textContent.includes('Naskah Masuk')
        );

        return {
            notOnLoginOrRole: !currentUrl.includes('/login') && !currentUrl.includes('/role'),
            hasMainMenu: hasMainMenu,
            hasNaskahMasuk: hasNaskahMasuk
        };
    });

    console.log(chalk.gray(`  → Login check: ${JSON.stringify(alreadyLoggedIn)}`));

    // If already logged in with role selected, skip role selection
    if (alreadyLoggedIn.notOnLoginOrRole && alreadyLoggedIn.hasMainMenu) {
        console.log(chalk.green('  ✓ Already logged in with role selected'));
        console.log(chalk.gray('  → Skipping role selection'));
        return;
    }

    if (!onRolePage && !hasRoleTitle) {
        // Try to navigate to role page
        console.log(chalk.yellow('  ⚠ Not on role selection page, trying to navigate...'));
        try {
            await page.goto('https://sidia.bpjsketenagakerjaan.go.id/role', {
                waitUntil: 'networkidle2',
                timeout: 15000
            });
            await sleep(3000);
            console.log(chalk.green('  ✓ Navigated to role selection page'));
        } catch (error) {
            console.log(chalk.yellow(`  ⚠ Could not navigate to role page: ${error.message}`));
            console.log(chalk.gray('  ℹ May already have a role selected'));
            return;
        }
    } else {
        console.log(chalk.green('  ✓ On role selection page'));
    }

    // Verify we're on the right page
    const pageCheck = await page.evaluate(() => {
        const title = document.querySelector('.v-toolbar__title');
        return {
            title: title ? title.textContent : null,
            url: window.location.href,
            hasInput: document.querySelector('input[type="text"]') !== null
        };
    });

    console.log(chalk.gray(`  → Page title: "${pageCheck.title}"`));
    console.log(chalk.gray(`  → Has input field: ${pageCheck.hasInput}`));

    if (!pageCheck.title || !pageCheck.title.includes('PILIH ROLE')) {
        console.log(chalk.yellow('  ⚠ Not on PILIH ROLE page - may already be logged in'));
        return;
    }

    // STEP 1: Find and click the role input field
    console.log(chalk.gray('  → Looking for role input field...'));

    // ENHANCED: Look for the exact role input structure you provided
    const roleInputAnalysis = await page.evaluate(() => {
        const results = {
            foundInputs: [],
            roleInputs: [],
            recommended: null
        };

        // Find all text inputs with autocomplete="off"
        const allInputs = Array.from(document.querySelectorAll('input'));
        allInputs.forEach(input => {
            const rect = input.getBoundingClientRect();
            const isVisible = rect.width > 0 && rect.height > 0 && input.offsetParent !== null;

            if (input.type === 'text' && isVisible) {
                const inputInfo = {
                    id: input.id,
                    type: input.type,
                    placeholder: input.placeholder,
                    className: input.className,
                    autocomplete: input.autocomplete || '',
                    visible: isVisible,
                    hasLabel: false,
                    labelText: '',
                    hasDropdownIcon: false,
                    parentStructure: ''
                };

                // Check for label
                const label = document.querySelector(`label[for="${input.id}"]`);
                if (label) {
                    inputInfo.hasLabel = true;
                    inputInfo.labelText = label.textContent;
                }

                // Check for dropdown icon in parent structure
                const parent = input.closest('.v-select__slot');
                if (parent) {
                    inputInfo.parentStructure = 'v-select__slot';
                    const dropdownIcon = parent.querySelector('.mdi-menu-down');
                    if (dropdownIcon) {
                        inputInfo.hasDropdownIcon = true;
                    }
                }

                results.foundInputs.push(inputInfo);

                // Check if this looks like the role input
                if (input.autocomplete === 'off' && inputInfo.hasDropdownIcon) {
                    results.roleInputs.push(inputInfo);
                }

                // Check if this matches your exact structure
                if (inputInfo.hasLabel &&
                    inputInfo.labelText.includes('Role') &&
                    input.autocomplete === 'off' &&
                    inputInfo.hasDropdownIcon) {
                    results.recommended = inputInfo;
                }
            }
        });

        return results;
    });

    console.log(chalk.gray(`    → Found ${roleInputAnalysis.foundInputs.length} visible text inputs`));
    console.log(chalk.gray(`    → Found ${roleInputAnalysis.roleInputs.length} potential role inputs`));

    // Log all found inputs for debugging
    roleInputAnalysis.foundInputs.forEach((input, i) => {
        const labelInfo = input.hasLabel ? ` [label: "${input.labelText}"]` : '';
        const dropdownInfo = input.hasDropdownIcon ? ' [dropdown icon]' : '';
        console.log(chalk.gray(`    → Input ${i + 1}: id="${input.id}", autocomplete="${input.autocomplete}"${labelInfo}${dropdownInfo}`));
    });

    // Use recommended input if found, otherwise fall back to first role input
    let roleInputId = null;
    let roleInputSelector = null;

    if (roleInputAnalysis.recommended) {
        roleInputId = roleInputAnalysis.recommended.id;
        roleInputSelector = `#${roleInputId}`;
        console.log(chalk.green(`    → Using recommended role input: ${roleInputSelector}`));
        console.log(chalk.gray(`    → Label: "${roleInputAnalysis.recommended.labelText}"`));
    } else if (roleInputAnalysis.roleInputs.length > 0) {
        roleInputId = roleInputAnalysis.roleInputs[0].id;
        roleInputSelector = `#${roleInputId}`;
        console.log(chalk.yellow(`    → Using fallback role input: ${roleInputSelector}`));
    } else if (roleInputAnalysis.foundInputs.length > 0) {
        // Last resort - use first visible text input
        roleInputId = roleInputAnalysis.foundInputs[0].id;
        roleInputSelector = `#${roleInputId}`;
        console.log(chalk.yellow(`    → Using last resort input: ${roleInputSelector}`));
    }

    // CAPTURE: Screenshot AND HTML structure after finding input
    await captureScreenshot(page, 'role_page_input_found');
    await capturePageStructure(page, 'role_page_input_found');

    if (!roleInputSelector) {
        console.log(chalk.red('  ✗ No suitable input field found'));
        await captureScreenshot(page, 'role_page_no_input_found');
        await capturePageStructure(page, 'role_page_no_input_found');
        return;
    }

    // Click the input field using DIRECT click (bypassing visibility detection issues)
    console.log(chalk.gray(`    → Clicking input: ${roleInputSelector}`));

    try {
        console.log(chalk.gray(`    → Using direct Puppeteer click for ${roleInputSelector}`));

        // Use direct Puppeteer click instead of page.evaluate
        await page.click(roleInputSelector, { clickCount: 1, delay: 100 });
        console.log(chalk.green(`    ✓ Direct click successful: ${roleInputSelector}`));

        // Also focus the input using JavaScript
        await page.evaluate((selector) => {
            const input = document.querySelector(selector);
            if (input) {
                input.click();
                input.focus();
                // Trigger any Vue events
                input.dispatchEvent(new Event('focus', { bubbles: true }));
                input.dispatchEvent(new Event('click', { bubbles: true }));
            }
        }, roleInputSelector);

        await sleep(2000);

        // Check if dropdown appeared
        const dropdownCheck = await page.evaluate(() => {
            const menu = document.querySelector('.v-menu__content, .v-select-list');
            const listItems = document.querySelectorAll('.v-list-item');
            const input = document.querySelector('input[type="text"][autocomplete="off"]');

            return {
                hasMenu: menu !== null,
                listItemCount: listItems.length,
                inputExists: input !== null,
                inputValue: input ? input.value : ''
            };
        });

        console.log(chalk.gray(`    → Dropdown check: menu=${dropdownCheck.hasMenu}, items=${dropdownCheck.listItemCount}, input value="${dropdownCheck.inputValue}"`));

        if (dropdownCheck.listItemCount > 0) {
            console.log(chalk.green(`    ✓ Dropdown appeared with ${dropdownCheck.listItemCount} items`));
        } else {
            console.log(chalk.yellow(`    ⚠ No dropdown items yet, but continuing...`));
        }

    } catch (error) {
        console.log(chalk.red(`  ✗ Failed to click input field: ${error.message}`));
        await captureScreenshot(page, 'role_page_input_click_failed');
        await capturePageStructure(page, 'role_page_input_click_failed');
        return;
    }

    await sleep(2000);

    // CAPTURE: Screenshot AND HTML structure after clicking input
    await captureScreenshot(page, 'role_page_after_input_click');
    await capturePageStructure(page, 'role_page_after_input_click');

    // STEP 2: Wait for dropdown and select first role (using DIRECT click approach)
    console.log(chalk.gray('  → Waiting for dropdown options...'));
    await sleep(3000);

    // Get all role options from the dropdown/menu (without visibility check)
    const roleOptions = await page.evaluate(() => {
        const selectors = [
            '.v-list-item',
            '.v-list-item__title',
            '[role="option"]',
            '.v-menu__content .v-list-item',
            '.v-list-item--link',
            '.v-select-list .v-list-item'
        ];

        const options = [];
        const seenTexts = new Set();

        for (const selector of selectors) {
            const elements = Array.from(document.querySelectorAll(selector));
            for (const el of elements) {
                const text = (el.textContent || '').trim();
                // Skip buttons and short text
                const isClickable = !el.classList.contains('v-btn') &&
                                  !el.closest('button') &&
                                  text.length > 5;

                if (isClickable && !seenTexts.has(text)) {
                    seenTexts.add(text);
                    options.push({
                        selector: selector,
                        text: text,
                        className: el.className,
                        id: el.id
                    });
                }
            }
        }
        return options;
    });

    console.log(chalk.gray(`    → Found ${roleOptions.length} role options`));

    if (roleOptions.length === 0) {
        console.log(chalk.yellow('  ⚠ No role options found in dropdown'));

        // Try clicking the input again to trigger dropdown
        console.log(chalk.gray('    → Trying to click input again...'));
        try {
            await page.click(roleInputSelector);
            await sleep(2000);
        } catch (e) {
            console.log(chalk.yellow(`    → Input reclick failed: ${e.message}`));
        }

        // Check again
        const roleOptions2 = await page.evaluate(() => {
            const items = Array.from(document.querySelectorAll('.v-list-item, .v-list-item__title'));
            return items
                .filter(el => {
                    const text = (el.textContent || '').trim();
                    return !el.classList.contains('v-btn') &&
                           !el.closest('button') &&
                           text.length > 5;
                })
                .map(el => ({
                    text: el.textContent.trim(),
                    selector: el.tagName.toLowerCase()
                }));
        });

        console.log(chalk.gray(`    → Found ${roleOptions2.length} role options on retry`));

        if (roleOptions2.length === 0) {
            console.log(chalk.red('  ✗ Still no role options found'));
            await captureScreenshot(page, 'role_page_no_options');
            await capturePageStructure(page, 'role_page_no_options');
            return;
        }

        roleOptions.push(...roleOptions2);
    }

    // Display first few options
    roleOptions.slice(0, 3).forEach((option, i) => {
        console.log(chalk.gray(`    → Option ${i + 1}: ${option.text.substring(0, 70)}`));
    });

    // Find PSTFF option or use first available option
    const firstOption = roleOptions[0];
    const pstffOption = roleOptions.find(opt => opt.text.includes('PSTFF'));
    const optionToSelect = pstffOption || firstOption;

    console.log(chalk.gray(`    → Selecting: ${optionToSelect.text.substring(0, 50)}`));

    try {
        // Use DIRECT click approach for role option (bypassing visibility detection)
        console.log(chalk.gray(`    → Using direct click for role option`));

        // Try multiple strategies to click the role option
        let optionClicked = false;

        // Strategy 1: Find and click by text content using page.evaluate
        const clickResult = await page.evaluate((targetText) => {
            const selectors = [
                '.v-list-item',
                '.v-list-item__title',
                '[role="option"]',
                '.v-select-list .v-list-item'
            ];

            for (const selector of selectors) {
                const elements = Array.from(document.querySelectorAll(selector));
                for (const el of elements) {
                    const text = (el.textContent || '').trim();

                    // Check if this is our target option
                    if (text.includes(targetText) &&
                        !el.classList.contains('v-btn') &&
                        !el.closest('button')) {

                        // Try clicking directly
                        el.click();

                        // Also try clicking parent if it's a title
                        if (el.classList.contains('v-list-item__title')) {
                            const parent = el.closest('.v-list-item');
                            if (parent) parent.click();
                        }

                        return {
                            clicked: true,
                            text: text,
                            selector: selector
                        };
                    }
                }
            }
            return { clicked: false, text: null, selector: null };
        }, optionToSelect.text);

        if (clickResult.clicked) {
            console.log(chalk.green(`    ✓ Clicked role option: "${clickResult.text}"`));
            optionClicked = true;
        } else {
            throw new Error('JavaScript click failed');
        }

        await sleep(2000);

        // Verify the selection worked
        const selectionCheck = await page.evaluate(() => {
            // Check for active class on selected item
            const activeItem = document.querySelector('.v-list-item--active, .v-item--active, .v-list-item.v-item--active');

            // Check input field value
            const textInput = document.querySelector('input[type="text"]');

            // Check PILIH button state
            const pilihBtn = Array.from(document.querySelectorAll('button, .v-btn')).find(btn =>
                btn.textContent.includes('PILIH') || btn.textContent.includes('Pilih')
            );

            return {
                hasActiveItem: activeItem !== null,
                inputHasValue: textInput ? textInput.value.trim() : '',
                pilihButtonDisabled: pilihBtn ? (pilihBtn.disabled || pilihBtn.classList.contains('v-btn--disabled')) : null,
                selectedText: activeItem ? activeItem.textContent.trim() : (textInput ? textInput.value : '')
            };
        });

        console.log(chalk.gray(`    → Selection check: active=${selectionCheck.hasActiveItem}, input value="${selectionCheck.inputHasValue}"`));
        console.log(chalk.gray(`    → PILIH disabled: ${selectionCheck.pilihButtonDisabled}`));

        if (selectionCheck.hasActiveItem || selectionCheck.inputHasValue) {
            console.log(chalk.green('  ✓ Role selection confirmed'));
        } else {
            console.log(chalk.yellow('  ⚠ Role selection not confirmed, but continuing...'));
        }

    } catch (error) {
        console.log(chalk.red(`  ✗ Failed to click role option: ${error.message}`));
        await captureScreenshot(page, 'role_page_option_click_failed');
        await capturePageStructure(page, 'role_page_option_click_failed');
        return;
    }

    // CAPTURE: Screenshot AND HTML structure after selecting role option
    await captureScreenshot(page, 'role_page_after_role_selected');
    await capturePageStructure(page, 'role_page_after_role_selected');

    // Verify the selection worked and wait for PILIH button to become enabled
    console.log(chalk.gray('  → Verifying role selection and waiting for PILIH button...'));
    await sleep(2000);

    // Check if role was actually selected
    const selectionCheck = await page.evaluate(() => {
        // Check for active class on selected item
        const activeItem = document.querySelector('.v-list-item--active, .v-item--active, .v-list-item.v-item--active');

        // Check input field value
        const textInput = document.querySelector('input[type="text"]');

        // Check PILIH button state
        const pilihBtn = Array.from(document.querySelectorAll('button, .v-btn')).find(btn =>
            btn.textContent.includes('PILIH') || btn.textContent.includes('Pilih')
        );

        return {
            hasActiveItem: activeItem !== null,
            inputHasValue: textInput ? textInput.value.trim() : '',
            pilihButtonDisabled: pilihBtn ? (pilihBtn.disabled || pilihBtn.classList.contains('v-btn--disabled')) : null,
            selectedText: activeItem ? activeItem.textContent.trim() : (textInput ? textInput.value : '')
        };
    });

    console.log(chalk.gray(`    → Active item: ${selectionCheck.hasActiveItem}`));
    console.log(chalk.gray(`    → Input value: "${selectionCheck.inputHasValue}"`));
    console.log(chalk.gray(`    → PILIH disabled: ${selectionCheck.pilihButtonDisabled}`));
    console.log(chalk.gray(`    → Selected: "${selectionCheck.selectedText}"`));

    if (selectionCheck.hasActiveItem || selectionCheck.inputHasValue) {
        console.log(chalk.green('  ✓ Role selection confirmed'));
    } else {
        console.log(chalk.yellow('  ⚠ Role selection not confirmed, but continuing...'));
    }

    // If PILIH button is still disabled, try clicking the role option again
    if (selectionCheck.pilihButtonDisabled === true) {
        console.log(chalk.yellow('  ⚠ PILIH button still disabled, trying to click role option again...'));
        await sleep(1000);

        // Try clicking the input field again to trigger selection
        try {
            await page.click(roleInputSelector);
            await sleep(1000);

            // Then click the first option again (without visibility check)
            const reclickResult = await page.evaluate((targetText) => {
                const listItems = Array.from(document.querySelectorAll('.v-list-item'));
                for (const item of listItems) {
                    const text = item.textContent.trim();
                    if (!item.classList.contains('v-btn') && text.includes(targetText)) {
                        item.click();
                        return { clicked: true, text: text };
                    }
                }
                return { clicked: false };
            }, optionToSelect.text);

            if (reclickResult.clicked) {
                console.log(chalk.green(`    → Reclicked role option: "${reclickResult.text}"`));
            }

            await sleep(2000);
        } catch (e) {
            console.log(chalk.yellow(`    → Reclick failed: ${e.message}`));
        }
    }

    // STEP 3: Click PILIH button (with direct approach)
    console.log(chalk.gray('  → Clicking PILIH button...'));

    try {
        console.log(chalk.gray('    → Using direct click for PILIH button'));

        // Find PILIH button using multiple strategies
        const pilihFound = await page.evaluate(() => {
            const buttons = Array.from(document.querySelectorAll('button, .v-btn'));
            const pilihBtn = buttons.find(btn =>
                (btn.textContent || '').includes('PILIH') ||
                (btn.textContent || '').includes('Pilih')
            );

            if (!pilihBtn) return { found: false };

            return {
                found: true,
                disabled: pilihBtn.disabled,
                hasDisabledClass: pilihBtn.classList.contains('v-btn--disabled'),
                text: (pilihBtn.textContent || '').trim()
            };
        });

        if (!pilihFound.found) {
            throw new Error('PILIH button not found');
        }

        console.log(chalk.gray(`    → PILIH button: "${pilihFound.text}", disabled=${pilihFound.disabled || pilihFound.hasDisabledClass}`));

        if (pilihFound.disabled || pilihFound.hasDisabledClass) {
            console.log(chalk.yellow('    ⚠ PILIH button is disabled, waiting...'));
            await sleep(3000);

            // Check again
            const recheck = await page.evaluate(() => {
                const pilihBtn = Array.from(document.querySelectorAll('button, .v-btn')).find(btn =>
                    (btn.textContent || '').includes('PILIH')
                );
                return {
                    disabled: pilihBtn ? (pilihBtn.disabled || pilihBtn.classList.contains('v-btn--disabled')) : true
                };
            });

            if (recheck.disabled) {
                throw new Error('PILIH button still disabled after waiting');
            }
        }

        // Click the PILIH button directly using JavaScript
        await page.evaluate(() => {
            const buttons = Array.from(document.querySelectorAll('button, .v-btn'));
            const pilihBtn = buttons.find(btn =>
                (btn.textContent || '').includes('PILIH') ||
                (btn.textContent || '').includes('Pilih')
            );

            if (pilihBtn && !pilihBtn.disabled && !pilihBtn.classList.contains('v-btn--disabled')) {
                pilihBtn.click();
                return { clicked: true };
            }
            return { clicked: false };
        });

        console.log(chalk.green('    ✓ PILIH button clicked'));

        // Wait for navigation
        await sleep(5000);

        // Verify we're no longer on role page
        const finalUrl = page.url();
        console.log(chalk.gray(`    → Final URL: ${finalUrl}`));

        if (finalUrl.includes('/role')) {
            console.log(chalk.yellow('    ⚠ Still on role page, waiting longer...'));
            await sleep(5000);

            const recheckUrl = page.url();
            console.log(chalk.gray(`    → Recheck URL: ${recheckUrl}`));

            if (recheckUrl.includes('/role')) {
                console.log(chalk.red('    ✗ Still on role page - PILIH may have failed'));
            } else {
                console.log(chalk.green('    ✓ Successfully navigated away from role page'));
            }
        } else {
            console.log(chalk.green('    ✓ Successfully navigated away from role page'));
        }

    } catch (error) {
        console.log(chalk.red(`  ✗ PILIH button click failed: ${error.message}`));
        await captureScreenshot(page, 'role_page_pilih_failed');
        await capturePageStructure(page, 'role_page_pilih_failed');
    }

    // CAPTURE: Final screenshot AND HTML structure after PILIH button click
    await captureScreenshot(page, 'role_page_after_pilih_click');
    await capturePageStructure(page, 'role_page_after_pilih_click');
}

/**
 * Click PILIH button with comprehensive verification
 * @param {Page} page - Puppeteer page instance
 */
async function clickPilihButton(page) {
    console.log(chalk.gray('  → Clicking PILIH button with verification...'));

    const pilihResult = await clickAndVerify(page, {
        elementDescription: 'PILIH button',
        findFn: () => {
            const buttons = Array.from(document.querySelectorAll('button, .v-btn'));
            const pilihBtn = buttons.find(btn =>
                (btn.textContent || '').includes('PILIH') ||
                (btn.textContent || '').includes('Pilih')
            );

            if (!pilihBtn) return { found: false };

            return {
                found: true,
                disabled: pilihBtn.disabled,
                hasDisabledClass: pilihBtn.classList.contains('v-btn--disabled'),
                visible: pilihBtn.offsetParent !== null,
                text: (pilihBtn.textContent || '').trim()
            };
        },
        clickFn: () => {
            const buttons = Array.from(document.querySelectorAll('button, .v-btn'));
            const pilihBtn = buttons.find(btn =>
                (btn.textContent || '').includes('PILIH') ||
                (btn.textContent || '').includes('Pilih')
            );

            if (pilihBtn && !pilihBtn.disabled && !pilihBtn.classList.contains('v-btn--disabled')) {
                pilihBtn.click();
                return { clicked: true };
            }
            return { clicked: false };
        },
        verifyStateChangeFn: () => {
            // Check if URL changed or if we're no longer on role page
            const currentUrl = window.location.href;
            const hasRoleTitle = document.querySelector('.v-toolbar__title')?.textContent.includes('PILIH ROLE');

            return {
                verified: !currentUrl.includes('/role') || !hasRoleTitle,
                url: currentUrl,
                hasRoleTitle: hasRoleTitle
            };
        },
        timeout: 10000,
        retryCount: 10
    });

    if (pilihResult.success) {
        console.log(chalk.green('  ✓ PILIH button clicked and verified'));

        // Handle different result structures
        if (pilihResult.afterState && pilihResult.afterState.url) {
            console.log(chalk.gray(`  → Navigation verified: ${pilihResult.afterState.url}`));
        }

        await sleep(TIMING.ROLE_SELECTION);

        // CRITICAL: Verify we're no longer on the role page
        const finalUrl = page.url();
        const stillOnRolePage = finalUrl.includes('/role') || finalUrl.includes('/select-role');

        if (stillOnRolePage) {
            console.log(chalk.yellow('  ⚠ Still on role page after PILIH click, waiting longer...'));
            await sleep(5000);

            // Check again
            const recheckUrl = page.url();
            if (recheckUrl.includes('/role')) {
                console.log(chalk.red('  ✗ Still on role page - role selection may have failed'));
                console.log(chalk.gray('  → Current URL: ' + recheckUrl));
            } else {
                console.log(chalk.green('  ✓ Finally navigated away from role page'));
            }
        } else {
            console.log(chalk.green('  ✓ Successfully navigated away from role page'));
            console.log(chalk.gray(`  → Final URL: ${finalUrl}`));
        }
    } else {
        console.log(chalk.red(`  ✗ PILIH button click verification failed: ${pilihResult.reason}`));
        console.log(chalk.gray('  ℹ Continuing anyway - role might already be selected'));

        // Check if we're actually on the right page now
        const currentUrl = page.url();
        if (!currentUrl.includes('/role')) {
            console.log(chalk.yellow('  ⚠ PILIH verification failed but URL changed - may have worked'));
            console.log(chalk.gray(`  → Current URL: ${currentUrl}`));
        }
    }
}

module.exports = {
    login,
    selectRole
};